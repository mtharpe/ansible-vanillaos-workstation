#!/bin/sh
# Checks every commit about to be pushed: diffs, file names and messages
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
        range=$local_sha      # new branch or rewritten history: check all of it
    else
        range=$remote_sha..$local_sha
    fi
    "$top/scripts/leak-check" --range "$range" || status=1
done
exit $status
