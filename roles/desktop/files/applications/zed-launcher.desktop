[Desktop Entry]
Name=Zed
Comment=Zed editor with Claude agent (choose Work or Personal profile)
GenericName=Text Editor
Keywords=zed;editor;code;Claude;
Exec=/home/tharpem/.local/bin/zed-launcher %U
Icon=zed
Type=Application
StartupNotify=false
StartupWMClass=dev.zed.Zed
Categories=Development;IDE;
Actions=Work;Personal;

[Desktop Action Work]
Name=Open Work
Exec=/home/tharpem/.local/bin/zed-launcher work

[Desktop Action Personal]
Name=Open Personal
Exec=/home/tharpem/.local/bin/zed-launcher personal
