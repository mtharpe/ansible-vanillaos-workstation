#!/bin/sh
# Native messaging host for the 1Password extension in Flatpak Chrome. Chrome runs this
# inside its sandbox; it hops to the host (the Chrome override allows
# org.freedesktop.Flatpak), where 1password-chrome-flatpak (from 1password-host-update)
# starts 1Password's BrowserSupport to relay to the running app.
exec flatpak-spawn --host /usr/local/libexec/1password-chrome-flatpak "$@"
