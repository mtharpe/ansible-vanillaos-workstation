[Desktop Entry]
Name=Bitwarden
Comment=Start Bitwarden (apx-bitwarden) hidden to tray on login, for the browser extension's biometric unlock
Exec=/home/tharpem/.local/bin/bitwarden-desktop --autostart
Terminal=false
Type=Application
Icon=bitwarden
StartupWMClass=Bitwarden
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
