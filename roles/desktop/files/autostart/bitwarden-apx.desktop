[Desktop Entry]
Name=Bitwarden
Comment=Start Bitwarden (apx-bitwarden) hidden to tray on login, for the browser extension's biometric unlock
Exec=/usr/share/apx/distrobox/distrobox-enter -n apx-bitwarden -- /opt/Bitwarden/bitwarden --autostart
Terminal=false
Type=Application
Icon=bitwarden
StartupWMClass=Bitwarden
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
