[Unit]
Description=Rebuild the custom Hylki (Mail) on new Hylki releases
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/src/github/mtharpe/hylki/tools/custom/update.sh

[Service]
Type=oneshot
ExecStart=%h/src/github/mtharpe/hylki/tools/custom/update.sh
TimeoutStartSec=2h

# Prefer foreground applications while automatic builds run.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
