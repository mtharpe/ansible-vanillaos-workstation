#!/bin/sh
# Git signs commits with `ssh-keygen -Y sign`, which reaches a key only through
# SSH_AUTH_SOCK — it ignores IdentityAgent in ~/.ssh/config. The key is served by rbw's
# agent (bitwarden apx subsystem), so point at that socket whatever shell or apx container
# git runs from; apx-vso-native sees the host's /run/user only under /run/host.
for sock in /run/user/1000/rbw/ssh-agent-socket /run/host/run/user/1000/rbw/ssh-agent-socket; do
    if [ -S "$sock" ]; then
        SSH_AUTH_SOCK=$sock exec ssh-keygen "$@"
    fi
done
exec ssh-keygen "$@"
