#!/usr/bin/env python3
"""Pause and resume media players when a Bluetooth headset's output comes back.

With multipoint, switching the headset to another device and back removes and
re-creates its PipeWire sink. Chrome's stream is moved back to it but keeps the
latency it had read before, so YouTube video runs ahead of or behind the audio.
Pausing and playing makes Chrome read the new latency.

When a new bluez_output sink appears and a playback stream is linked to it, every
MPRIS player that is playing is paused for PAUSE_SECONDS and resumed. Sinks already
there when the service starts are left alone.

Environment:
  PAUSE_SECONDS  how long to pause (default 1)
"""
import json
import os
import select
import subprocess
import sys
import time

PAUSE_SECONDS = float(os.environ.get("PAUSE_SECONDS", "1"))
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_PLAYER = "org.mpris.MediaPlayer2.Player"
DEBOUNCE = 0.5
# A new sink with no stream linked within this long is forgotten
PENDING_TIMEOUT = 30


def log(msg):
    print(msg, flush=True)


def snapshot():
    """Return (bluetooth sink ids, ids of sinks that have a playback stream linked)."""
    dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, check=True).stdout)

    def props(o):
        return (o.get("info") or {}).get("props") or {}

    nodes = {o["id"]: props(o) for o in dump if o.get("type") == "PipeWire:Interface:Node"}
    bt_sinks = {
        i for i, p in nodes.items()
        if p.get("media.class") == "Audio/Sink" and p.get("node.name", "").startswith("bluez_output.")
    }
    fed = set()
    for o in dump:
        if o.get("type") != "PipeWire:Interface:Link":
            continue
        info = o.get("info") or {}
        src = nodes.get(info.get("output-node-id"), {})
        if info.get("input-node-id") in bt_sinks and src.get("media.class") == "Stream/Output/Audio":
            fed.add(info["input-node-id"])
    return bt_sinks, fed


def busctl(*args):
    return subprocess.run(["busctl", "--user", *args], capture_output=True, text=True, check=False)


def playing_players():
    names = busctl("list", "--no-legend", "--acquired").stdout.split()
    players = [n for n in names if n.startswith("org.mpris.MediaPlayer2.")]
    return [
        p for p in players
        if busctl("get-property", p, MPRIS_PATH, MPRIS_PLAYER, "PlaybackStatus").stdout.strip() == 's "Playing"'
    ]


def resync(sink):
    players = playing_players()
    if not players:
        log(f"sink {sink} is back, nothing playing")
        return
    for p in players:
        busctl("call", p, MPRIS_PATH, MPRIS_PLAYER, "Pause")
    time.sleep(PAUSE_SECONDS)
    for p in players:
        busctl("call", p, MPRIS_PATH, MPRIS_PLAYER, "Play")
    log(f"sink {sink} is back, paused and resumed {', '.join(players)}")


def main():
    known = None  # bluetooth sink ids seen so far
    pending = {}  # new sink id -> time it appeared
    mon = subprocess.Popen(["pw-mon", "-N", "-o", "-a"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    dirty_at = time.monotonic()
    while True:
        ready, _, _ = select.select([mon.stdout], [], [], DEBOUNCE)
        if ready:
            if not mon.stdout.readline():
                log("pw-mon exited")
                return 1
            dirty_at = time.monotonic()
            continue
        now = time.monotonic()
        pending = {s: t for s, t in pending.items() if now - t < PENDING_TIMEOUT}
        if dirty_at is None and not pending:
            continue
        dirty_at = None
        try:
            bt_sinks, fed = snapshot()
        except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
            log(f"pw-dump failed: {e}")
            continue
        if known is not None:
            for s in bt_sinks - known:
                pending[s] = now
        known = bt_sinks
        for s in list(pending):
            if s not in bt_sinks:
                del pending[s]
            elif s in fed:
                del pending[s]
                resync(s)


if __name__ == "__main__":
    sys.exit(main())
