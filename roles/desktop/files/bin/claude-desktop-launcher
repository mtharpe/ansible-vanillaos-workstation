#!/bin/bash
# Launch Claude Desktop in the work or personal apx subsystem.
#   claude-desktop-launcher                  -> ask which profile, then launch
#   claude-desktop-launcher work|personal    -> launch that profile directly
#   claude-desktop-launcher claude://...     -> hand a deep link (e.g. sign-in)
#                                               to the last profile launched
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state_file="$state_dir/claude-desktop-profile"
last=$(cat "$state_file" 2>/dev/null || echo work)

profile=""
args=()
case "${1:-}" in
    work|personal) profile=$1; shift ;;
    "") ;;
    *) profile=$last ;;  # deep link / file: route to the last profile used
esac
args=("$@")

if [[ -z "$profile" ]]; then
    work_default=FALSE personal_default=FALSE
    [[ "$last" == personal ]] && personal_default=TRUE || work_default=TRUE
    profile=$(zenity --list --radiolist --title="Claude" \
        --text="Which profile do you want to use?" \
        --column="" --column="Profile" --column="Name" --hide-column=3 \
        --print-column=3 --width=320 --height=220 \
        "$work_default" "Work" work \
        "$personal_default" "Personal" personal) || exit 0
    [[ -n "$profile" ]] || exit 0
fi

mkdir -p "$state_dir"
echo "$profile" > "$state_file"

exec /usr/share/apx/distrobox/distrobox-enter -n "apx-claude-$profile" -- \
    claude-desktop "${args[@]}"
