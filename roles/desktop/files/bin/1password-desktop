#!/bin/sh
# Run 1Password in the apx-1password subsystem. Like Bitwarden, it needs the host's system
# bus (under /run/host in the container) to reach polkit for system authentication unlock.
exec /usr/share/apx/distrobox/distrobox-enter -n apx-1password -- \
    env DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/host/run/dbus/system_bus_socket \
    /opt/1Password/1password "$@"
