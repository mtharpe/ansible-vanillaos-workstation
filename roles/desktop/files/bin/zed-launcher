#!/bin/bash
# Launch zed directly in the work Claude apx subsystem.
set -euo pipefail

# Keep the explicit work shortcut supported.
[[ "${1:-}" == work ]] && shift
# The inner shell expands its own HOME and arguments.
# shellcheck disable=SC2016
exec /usr/share/apx/distrobox/distrobox-enter -n apx-claude-work -- \
    bash -lc 'exec "$HOME/.local/bin/zed" "$@"' zed "$@"
