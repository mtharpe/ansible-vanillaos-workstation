#!/usr/bin/python3
"""Merge managed Zed/Chrome preferences, preserving unrelated user settings."""
import argparse
import copy
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile

BACKUP_ROOT = Path.home() / '.local/state/workstation-settings'
CHROME_PATCH = {'performance_tuning': {'high_efficiency_mode': {'state': 2, 'aggressiveness': 1}}}
DECODER = json.JSONDecoder()


def clean_jsonc(source):
    """Replace comments/trailing commas with whitespace, preserving offsets."""
    chars = list(source)
    i = 0
    while i < len(source):
        if source[i] == '"':
            _, i = DECODER.raw_decode(source, i)
        elif source.startswith('//', i) or source.startswith('/*', i):
            if source.startswith('//', i):
                end = source.find('\n', i)
                end = len(source) if end < 0 else end
            else:
                end = source.find('*/', i + 2)
                if end < 0:
                    raise ValueError('Unterminated JSONC comment')
                end += 2
            for j in range(i, end):
                if chars[j] not in '\r\n':
                    chars[j] = ' '
            i = end
        else:
            i += 1
    cleaned = ''.join(chars)
    i = 0
    while i < len(cleaned):
        if cleaned[i] == '"':
            _, i = DECODER.raw_decode(cleaned, i)
        elif cleaned[i] == ',':
            j = i + 1
            while j < len(cleaned) and cleaned[j].isspace():
                j += 1
            if j < len(cleaned) and cleaned[j] in '}]':
                chars[i] = ' '
            i += 1
        else:
            i += 1
    return ''.join(chars)


def deep_merge(original, patch):
    merged = copy.deepcopy(original) if isinstance(original, dict) else {}
    for key, value in patch.items():
        merged[key] = deep_merge(merged.get(key), value) if isinstance(value, dict) else value
    return merged


def member_span(cleaned, key):
    depth = 0
    i = 0
    while i < len(cleaned):
        char = cleaned[i]
        if char == '"':
            token, end = DECODER.raw_decode(cleaned, i)
            j = end
            while j < len(cleaned) and cleaned[j].isspace():
                j += 1
            if depth == 1 and token == key and j < len(cleaned) and cleaned[j] == ':':
                j += 1
                while cleaned[j].isspace():
                    j += 1
                _, end_value = DECODER.raw_decode(cleaned, j)
                return j, end_value
            i = end
        else:
            if char in '{[':
                depth += 1
            elif char in '}]':
                depth -= 1
            i += 1
    return None


def merge_settings(source, patch):
    cleaned = clean_jsonc(source)
    original = json.loads(cleaned)
    if not isinstance(original, dict):
        raise ValueError('Settings must be a JSON object')
    desired = deep_merge(original, patch)
    for key in patch:
        if key in original and original[key] == desired[key]:
            continue
        cleaned = clean_jsonc(source)
        value = json.dumps(desired[key], indent=2, ensure_ascii=False).replace('\n', '\n  ')
        span = member_span(cleaned, key)
        if span:
            source = source[:span[0]] + value + source[span[1]:]
        else:
            start = cleaned.index('{') + 1
            # Insert first: existing JSONC trailing commas remain valid.
            existing = json.loads(cleaned)
            entry = '\n  ' + json.dumps(key) + ': ' + value + (',' if existing else '') + '\n'
            source = source[:start] + entry + source[start:]
    if json.loads(clean_jsonc(source)) != desired:
        raise ValueError('Merged settings failed validation')
    return source


def chrome_running():
    result = subprocess.run(['/usr/bin/flatpak', 'ps', '--columns=application'],
                            check=True, capture_output=True, text=True, timeout=15)
    return 'com.google.Chrome' in result.stdout.splitlines()


def configure(path, patch, check=False, chrome=False):
    path = Path(path)
    original = path.read_text() if path.exists() else '{}\n'
    updated = merge_settings(original, patch)
    changed = updated != original
    result = {'changed': changed, 'deferred': False, 'path': str(path)}
    if not changed or check:
        return result
    if chrome:
        try:
            running = chrome_running()
        except (OSError, subprocess.SubprocessError):
            running = True  # No safe browser status: never overwrite live preferences.
        if running:
            return dict(result, changed=False, deferred=True)
    BACKUP_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    BACKUP_ROOT.chmod(0o700)
    if path.exists():
        fd, backup = tempfile.mkstemp(prefix=path.name + '.', dir=BACKUP_ROOT)
        os.close(fd)
        shutil.copyfile(path, backup)
        os.chmod(backup, 0o600)
        result['backup'] = backup
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix='.workstation-settings-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(updated)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        if path.exists() and path.read_text() != original:
            raise RuntimeError('Settings changed concurrently; rerun to merge safely')
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--zed', type=Path)
    group.add_argument('--chrome', type=Path)
    parser.add_argument('--codex-command')
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    if args.zed:
        if not args.codex_command:
            parser.error('--zed requires --codex-command')
        patch = {'agent_servers': {
            'claude-acp': {'type': 'registry'},
            'Codex (Personal)': {'type': 'custom', 'command': args.codex_command, 'args': [], 'env': {}}}}
        result = configure(args.zed, patch, check=args.check)
    else:
        result = configure(args.chrome, CHROME_PATCH, check=args.check, chrome=True)
    print(json.dumps(result))
    return 75 if result['deferred'] else 0


if __name__ == '__main__':
    raise SystemExit(main())
