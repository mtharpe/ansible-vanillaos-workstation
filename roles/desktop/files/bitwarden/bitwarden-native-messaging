#!/bin/sh
# Native messaging host for the Bitwarden browser extension in Flatpak Chrome. Chrome runs
# this inside its sandbox; it hops to the host (the Chrome override allows
# org.freedesktop.Flatpak) and runs Bitwarden's desktop_proxy in the apx-bitwarden
# subsystem, which relays to the running desktop app.
exec flatpak-spawn --host /usr/share/apx/distrobox/distrobox-enter -n apx-bitwarden -- \
    /opt/Bitwarden/desktop_proxy "$@"
