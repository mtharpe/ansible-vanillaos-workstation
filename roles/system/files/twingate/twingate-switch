#!/bin/bash
# Root side of the `twingate` launcher in ~/.bash_aliases, run through pkexec. The host has no
# sudo, which the Twingate CLI uses for these commands, so they run here as root instead.
#   twingate-switch connect [account] start the service, switch to [account] if given, connect
#   twingate-switch off                disconnect
#   twingate-switch add                first-time setup, or add another account
# A polkit rule lets the desktop user run this without a password; only these actions exist.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

PROFILES=/var/lib/twingate/profiles

# Last line of `twingate status`; while signing in it's the sign-in URL
state() {
    local s
    s=$(twingate-classic status 2>/dev/null | tail -1) || true
    [[ $s == http* ]] && s=sign-in
    echo "${s:-unknown}"
}

# Field of the active account's info.json (email, network_slug)
active() {
    sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$PROFILES/$(<"$PROFILES/default")/info.json" 2>/dev/null
}

# Whether account id $1 (email or email:network) is the active account. Other id forms (the
# 4-character account ID) can't be checked here and count as active.
is_active() {
    [[ $1 == *@* ]] || return 0
    [[ $(active email) == "${1%%:*}" ]] || return 1
    [[ $1 != *:* || $(active network_slug) == "${1#*:}" ]]
}

# Start the daemon on the active account. In background daemon mode it only connects when the
# service starts; `twingate start` on a running, paused daemon does nothing.
cold_start() {
    systemctl restart twingate.service
    twingate-classic start >/dev/null 2>&1 || true
}

case ${1-} in
    connect)
        # Account id as `twingate account switch` takes it: email or email:network.
        # No account = connect whichever is active (the GNOME panel's toggle does this).
        [[ -z ${2-} || $2 =~ ^[A-Za-z0-9@._:+-]+$ ]] || { echo "twingate-switch: bad account '$2'" >&2; exit 2; }
        if [[ ${2-} ]] && ! is_active "$2"; then
            # Only ever change accounts with the daemon stopped. `account switch` on a running
            # daemon pauses it and then restarts it with sudo, which the host lacks, so it stays
            # paused on the old account; when that daemon later stops it saves its state into
            # the new account and wipes that account's sign-in.
            systemctl stop twingate.service
            # Exits 1 even when the switch worked (the sudo restart again), so check the result.
            # It asks "Are you sure? [y/N]" and reads no from an empty stdin, so answer it.
            out=$(printf 'y\ny\ny\n' | twingate-classic account switch -d "$2" 2>&1) || true
            if ! is_active "$2"; then
                # Accounts are only listed after their first sign-in; `twingate add` signs in
                echo "twingate-switch: couldn't switch to '$2' (not signed in yet? use add):"$'\n'"$out" >&2
                echo "Reconnecting $(active network_slug) instead" >&2
            fi
            cold_start
        elif [[ $(state) != online ]]; then
            cold_start
        fi
        # Wait for the connection (a sign-in page counts: the notifier opens it in the browser)
        for ((i = 0; i < 20; i++)); do
            s=$(state)
            [[ $s == online || $s == sign-in ]] && break
            sleep 1
        done
        case $s in
            online) echo "Twingate: online ($(active network_slug))" ;;
            sign-in) echo "Twingate: sign in to $(active network_slug) in your browser to finish connecting" ;;
            *)
                echo "twingate-switch: Twingate is '$s', not online" >&2
                exit 1
                ;;
        esac
        [[ -z ${2-} ]] || is_active "$2"
        ;;
    off)
        # `twingate stop` also runs `systemctl --user stop twingate-desktop-notifier`, which fails
        # as root (no user bus) and makes it exit 1 before stopping anything. Stop the daemon
        # directly; connect starts it again, and the notifier keeps running for sign-ins.
        systemctl stop twingate.service
        ;;
    add)
        systemctl start twingate.service
        # The package ships network.conf as a blank line, so check for an actual network name
        if grep -q '[^[:space:]]' /etc/twingate/network.conf 2>/dev/null; then
            twingate-classic account add || true
        else
            twingate-classic setup || true
        fi
        # The CLI's own "restart Twingate now?" fails here (No such file or directory), so restart
        # the service ourselves; the daemon then connects the new account and opens its sign-in
        if [[ $(twingate-classic status 2>/dev/null | tail -1) != online ]]; then
            echo "Restarting Twingate; sign in to the new account in your browser"
            systemctl restart twingate.service
            twingate-classic start
        fi
        ;;
    *)
        echo "usage: twingate-switch connect [account] | off | add" >&2
        exit 2
        ;;
esac
