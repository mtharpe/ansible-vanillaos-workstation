#!/bin/bash
# Install or update 1Password (desktop app + op CLI) on the Vanilla OS host, outside ABRoot.
# It runs on the host, not in an apx subsystem, because its system authentication unlock
# refuses a system D-Bus it can't verify, and in a rootless container the host's bus is
# owned by "nobody". /usr is read-only, so the official tarball goes to /opt (= /var/opt)
# and op to /usr/local, and this does what the packages' post-install scripts would.
#   1password-host-update          install, or update if 1Password published a newer version
#   1password-host-update --force  reinstall the latest versions
# Runs as root (pkexec once by hand, then 1password-host-update.timer weekly).
set -euo pipefail

TARBALL=https://downloads.1password.com/linux/tar/stable/x86_64/1password-latest.tar.gz
KEY_URL=https://downloads.1password.com/linux/keys/1password.asc
# 1Password's package signing key
KEY_FPR=3FEF9748469ADBE15DA7CA80AC2D62742012EA22
OP_CHECK=https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N
APP=/opt/1Password
PREFIX=/usr/local
STATE=/var/lib/1password-host

[[ $EUID -eq 0 ]] || { echo "1password-host-update: must run as root" >&2; exit 1; }
force=0; [[ ${1-} == --force ]] && force=1

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$STATE"

# A keyring with only 1Password's key, checked by fingerprint
export GNUPGHOME=$work/gnupg
install -dm700 "$GNUPGHOME"
curl -fsSL "$KEY_URL" -o "$work/key.asc"
gpg --batch --quiet --import "$work/key.asc"
gpg --batch --with-colons --fingerprint | grep -q "^fpr:::::::::$KEY_FPR:" ||
    { echo "1password-host-update: unexpected signing key" >&2; exit 1; }
verify() { gpg --batch --quiet --trust-model always --verify "$1" "$2" 2>/dev/null; }

for g in onepassword onepassword-cli onepassword-mcp; do
    getent group "$g" >/dev/null || groupadd "$g"
done

# Desktop app
curl -fsSL "$TARBALL" -o "$work/1password.tar.gz"
curl -fsSL "$TARBALL.sig" -o "$work/1password.tar.gz.sig"
verify "$work/1password.tar.gz.sig" "$work/1password.tar.gz" ||
    { echo "1password-host-update: bad signature on the 1Password tarball" >&2; exit 1; }
# head closes the pipe early, which kills tar (SIGPIPE) and would trip pipefail
top=$(tar -tzf "$work/1password.tar.gz" 2>/dev/null | head -1 || true)
version=${top%%/*}; version=${version#1password-}; version=${version%.x64}
[[ $version =~ ^[0-9][0-9.]+$ ]] || { echo "1password-host-update: no version in $top" >&2; exit 1; }

if [[ $force -eq 0 && -f $STATE/app-version && $(<"$STATE/app-version") == "$version" ]]; then
    echo "1Password $version is already installed"
else
    echo "Installing 1Password $version"
    mkdir "$work/app"
    tar -xzf "$work/1password.tar.gz" -C "$work/app" --strip-components=1
    new=$APP.new
    rm -rf "$new"
    cp -a "$work/app" "$new"
    chown -R root:root "$new"
    chmod -R go-w "$new"
    # As after-install.sh: Electron's sandbox helper is setuid; the setgid helpers let the
    # app check who's connecting (browser bridge, MCP server)
    chmod 4755 "$new/chrome-sandbox"
    chgrp onepassword "$new/1Password-BrowserSupport"
    chmod g+s "$new/1Password-BrowserSupport"
    if [[ -f $new/1password-mcp ]]; then
        chgrp onepassword-mcp "$new/1password-mcp"
        chmod g+s "$new/1password-mcp"
        ln -sf "$APP/1password-mcp" "$new/onepassword-mcp"
    fi
    # Swap in place: a running app keeps its open files until it restarts
    rm -rf "$APP.old"
    [[ -d $APP ]] && mv "$APP" "$APP.old"
    mv "$new" "$APP"
    rm -rf "$APP.old"
    install -dm755 "$PREFIX/share/icons"
    cp -rf "$APP/resources/icons/." "$PREFIX/share/icons/"
    echo "$version" >"$STATE/app-version"
fi

# The browser allowlist the app reads at start: the package's default plus chrome-flatpak,
# the stand-in that starts BrowserSupport for Flatpak Chrome (below)
install -dm755 /etc/1password
[[ -f /etc/1password/custom_allowed_browsers ]] ||
    install -m644 "$APP/resources/custom_allowed_browsers" /etc/1password/
[[ -z $(tail -c1 /etc/1password/custom_allowed_browsers) ]] || echo >>/etc/1password/custom_allowed_browsers
grep -qx chrome-flatpak /etc/1password/custom_allowed_browsers || echo chrome-flatpak >>/etc/1password/custom_allowed_browsers

# Flatpak Chrome's native messaging host runs 1password-chrome-flatpak on the host. The app
# accepts BrowserSupport only when its parent's executable is a known browser, so it runs as
# a child (the trailing exit keeps dash from exec-ing it) of a copy of dash named chrome-flatpak.
install -dm755 "$PREFIX/libexec/1password"
install -m755 /usr/bin/dash "$PREFIX/libexec/1password/chrome-flatpak"
cat >"$PREFIX/libexec/1password-chrome-flatpak" <<EOF
#!/bin/sh
# Run by Flatpak Chrome's 1Password native messaging host (flatpak-spawn --host)
exec $PREFIX/libexec/1password/chrome-flatpak -c '$APP/1Password-BrowserSupport "\$@"; exit \$?' chrome-flatpak "\$@"
EOF
chmod 755 "$PREFIX/libexec/1password-chrome-flatpak"

# op CLI: the zip carries a detached signature for the binary
op_version=$(curl -fsSL "$OP_CHECK" | python3 -Ic 'import json, sys; print(json.load(sys.stdin)["version"])')
if [[ $force -eq 0 && -f $STATE/op-version && $(<"$STATE/op-version") == "$op_version" ]]; then
    echo "op $op_version is already installed"
else
    echo "Installing op $op_version"
    curl -fsSL "https://cache.agilebits.com/dist/1P/op2/pkg/v$op_version/op_linux_amd64_v$op_version.zip" -o "$work/op.zip"
    unzip -q "$work/op.zip" op op.sig -d "$work/op"
    verify "$work/op/op.sig" "$work/op/op" ||
        { echo "1password-host-update: bad signature on op" >&2; exit 1; }
    install -m755 -o root -g onepassword-cli "$work/op/op" "$PREFIX/bin/op.new"
    chmod g+s "$PREFIX/bin/op.new"
    mv "$PREFIX/bin/op.new" "$PREFIX/bin/op"
    echo "$op_version" >"$STATE/op-version"
fi
