# Readline settings (bash and ble.sh). Loaded in apx containers via INPUTRC set in ~/.bashrc
$include /etc/inputrc

# Tab: case-insensitive, treat - and _ alike, list matches on first press
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set menu-complete-display-prefix on

# Colored completions with a type marker (/ for dirs, etc.) and highlighted common prefix
set colored-stats on
set visible-stats on
set mark-symlinked-directories on
set colored-completion-prefix on

# Up/Down search history for what's already typed (e.g. "cd " + Up)
"\e[A": history-search-backward
"\e[B": history-search-forward

# Tab cycles through matches, Shift-Tab goes back
TAB: menu-complete
"\e[Z": menu-complete-backward
